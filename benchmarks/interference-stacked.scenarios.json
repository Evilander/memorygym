        {
          "id": "oncall-apr-current",
          "day": 92,
          "type": "semantic",
          "entity": "Payments",
          "key": "primary_oncall",
          "value": "Tariq",
          "content": "Tariq is the active Payments primary on-call this April rotation and owns the new SRE pager schedule.",
          "salience": 0.95
