        {
          "id": "oncall-distractor-network",
          "day": 80,
          "type": "semantic",
          "entity": "Networking",
          "key": "primary_oncall",
          "value": "Tariq",
          "content": "Tariq also carries the Networking secondary on-call rotation, which is unrelated to the Payments pager.",
          "salience": 0.4
        }
      ],
      "probes": [
        {
          "id": "current-payments-pager",
          "query": "Who is on the Payments primary pager this week?",
          "type": "semantic",
          "expected": ["oncall-apr-current"],
          "forbidden": ["oncall-jan", "oncall-feb", "oncall-mar", "oncall-distractor-network"],
          "answerKeywords": ["Tariq", "Payments"],
          "topK": 4
        }
      ]
    }
  ]
}
