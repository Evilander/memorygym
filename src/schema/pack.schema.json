{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorygym.dev/schemas/pack.schema.json",
  "title": "MemoryGym Scenario Pack",
  "description": "A replayable benchmark suite for agent memory adapters.",
  "type": "object",
  "required": ["name", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?$"
    },
    "description": {
      "type": "string"
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxP95RecallLatencyMs": {
          "type": "number",
          "minimum": 0
        },
        "adapters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minScore": { "type": "number", "minimum": 0, "maximum": 1 },
              "minHitRate": { "type": "number", "minimum": 0, "maximum": 1 },
              "maxP95RecallLatencyMs": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["id", "title", "events", "probes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "dimensions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "context": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/event" }
        },
        "probes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/probe" }
        }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "content"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "day": { "type": "number" },
        "type": {
          "type": "string",
          "enum": ["semantic", "episodic", "procedural", "reflexive"]
        },
        "entity": { "type": "string" },
        "key": { "type": "string" },
        "value": { "type": "string" },
        "content": { "type": "string", "minLength": 1 },
        "source": {
          "type": "string",
          "enum": ["direct-observation", "told-by-user", "tool-result", "inference", "model-generated"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "context": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "audreyToolCall": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "arguments": { "type": "object" },
            "mapIdFrom": { "type": "string" },
            "memorygymEventId": { "type": "string" }
          }
        },
        "salience": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "probe": {
      "type": "object",
      "required": ["id", "query", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["recall", "abstention", "capability"],
          "default": "recall"
        },
        "query": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["semantic", "episodic", "procedural", "reflexive"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "context": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "requires": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilityArgs": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "expected": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbidden": {
          "type": "array",
          "items": { "type": "string" }
        },
        "answer": { "type": "string" },
        "answerKeywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "topK": {
          "type": "integer",
          "minimum": 1
        },
        "abstainThreshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "abstention" } } },
          "then": { "required": ["forbidden"] }
        },
        {
          "if": { "properties": { "kind": { "const": "capability" } } },
          "then": {
            "required": ["requires"],
            "properties": {
              "expected": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "not": {
              "anyOf": [
                { "properties": { "kind": { "const": "abstention" } } },
                { "properties": { "kind": { "const": "capability" } } }
              ]
            }
          },
          "then": {
            "properties": {
              "expected": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
